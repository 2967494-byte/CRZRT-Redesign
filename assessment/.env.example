ASMT_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=asmt
ASMT_DB_USER=asmt
ASMT_DB_PASS=asmt_secret
ASMT_APP_URL=http://localhost:8080
ASMT_SESSION_NAME=ASMTSESSID

# Обратный прокси. X-Forwarded-For и X-Forwarded-Proto принимаются только от
# 127.0.0.1, ::1 и адресов из этого списка. Прокси должен дописывать реальный
# адрес клиента в конец X-Forwarded-For (или подставлять $remote_addr целиком).
# ASMT_TRUSTED_PROXIES=10.0.0.5
# Принудительно помечать сессионную cookie флагом Secure (на HTTPS это происходит само):
# ASMT_COOKIE_SECURE=1

# Почта: log | mailhog | smtp
# Бой: smtp + Brevo (бесплатно ~300 писем/сутки) или другой релей
ASMT_MAIL_MODE=log
ASMT_MAIL_FROM=noreply@zakupki.tatar
ASMT_MAIL_FROM_NAME=ЦРЗ РТ — модуль тестирования
# ASMT_MAIL_REPLY_TO=support@zakupki.tatar
# Сколько писем сброса пароля можно отправить за сутки на весь сайт. Не даёт
# потоком запросов съесть квоту почтового сервиса, нужную для регистрации.
# ASMT_RESET_MAIL_DAILY_CAP=150
ASMT_MAILHOG_HOST=127.0.0.1
ASMT_MAILHOG_PORT=1025
# SMTP (пример Brevo):
# ASMT_SMTP_HOST=smtp-relay.brevo.com
# ASMT_SMTP_PORT=587
# ASMT_SMTP_ENCRYPTION=tls
# ASMT_SMTP_USER=
# ASMT_SMTP_PASS=
# После настройки DNS SPF/DKIM в кабинете Brevo — php scripts/mail_test.php you@mail.ru

ASMT_ADMIN_EMAIL=admin@assessment.local
ASMT_ADMIN_PASSWORD=Admin123!
ASMT_ESIA_ENABLED=0
# When keys are issued:
# ASMT_ESIA_ENABLED=1
# ASMT_ESIA_CLIENT_ID=
# ASMT_ESIA_REDIRECT_URI=https://test.zakupki.tatar/api/esia.php?action=callback

# DaData (ЕГРЮЛ по ИНН) — бесплатно до 10 тыс. запросов/сутки: https://dadata.ru/profile/#info
# ASMT_DADATA_TOKEN=
# ASMT_DADATA_SECRET=

# Мониторинг баланса Рег.облака (Cloud VPS):
# В панели рег.облако -> Настройки -> Настройки окружения -> API и Terraform -> скопировать токен:
ASMT_REGRU_TOKEN=

# Либо классический REG.API 2.0 (для обычного хостинга/доменов):
# ASMT_REGRU_USERNAME=
# ASMT_REGRU_PASSWORD=

